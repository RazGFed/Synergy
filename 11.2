import collections

pets = {

    1:

        {

            "Мухтар": {

                "Вид питомца": "Собака",

                "Возраст питомца": 9,

                "Имя владельца": "Павел"

            },

        },

    2:

        {

            "Каа": {

                "Вид питомца": "желторотый питон",

                "Возраст питомца": 19,

                "Имя владельца": "Саша"

            },

        }
}

def create():
    last = collections.deque(pets, maxlen=1)[0]
    new_id = last + 1
    name = input("Имя питомца: ").strip()
    species = input("Вид питомца: ").strip()
    age = int(input("Возраст питомца: "))
    owner = input("Имя владельца: ").strip()

    pets[new_id] = {
        name: {
            "Вид питомца": species,
            "Возраст питомца": age,
            "Имя владельца": owner
        }
    }
    print("Питомец успешно добавлен!")

def get_pet(ID):
    return pets[ID] if ID in pets.keys() else False

def get_suffix(age):
    if 11 <= age % 100 <= 14:
        return "лет"
    elif age % 10 == 1:
        return "год"
    elif 2 <= age % 10 <= 4:
        return "года"
    else:
        return "лет"

def pets_list():
    if not pets:
        print("Список питомцев пуст.")
    else:
        for ID, pet_data in pets.items():
            for name, info in pet_data.items():
                suffix = get_suffix(info["Возраст питомца"])
                print(f'ID {ID}: {info["Вид питомца"]} по кличке "{name}", {info["Возраст питомца"]} {suffix}, владелец: {info["Имя владельца"]}')

def read():
    ID = int(input("Введите ID питомца: "))
    pet_data = get_pet(ID)
    if pet_data:
        for name, info in pet_data.items():
            suffix = get_suffix(info["Возраст питомца"])
            print(f'Это {(info["Вид питомца"]).lower()} по кличке "{name}". Возраст питомца: {info["Возраст питомца"]} {suffix}. Имя владельца: {info["Имя владельца"]}.')
    else:
        print("Питомец с таким ID не найден.")

def delete():
    ID = int(input("Введите ID питомца, которого хотите удалить: "))
    if ID in pets:
        del pets[ID]
        print("Питомец удалён.")
    else:
        print("Питомец с таким ID не найден.")

def update():
    ID = int(input("Введите ID питомца, которого хотите обновить: "))
    pet_data = get_pet(ID)
    if pet_data:
        for name in pet_data:
            new_name = input(f"Новое имя питомца (было '{name}'): ").strip()
            species = input("Новый вид питомца: ").strip()
            age = int(input("Новый возраст питомца: "))
            owner = input("Новое имя владельца: ").strip()

            pets[ID] = {
                new_name: {
                    "Вид питомца": species,
                    "Возраст питомца": age,
                    "Имя владельца": owner
                }
            }
            print("Информация обновлена.")
            return
    else:
        print("Питомец с таким ID не найден.")

while True:
    command = input("\n Введите команду (create, read, update, delete, list, stop): ").strip().lower()
    if command == "create":
        create()
    elif command == "read":
        read()
    elif command == "update":
        update()
    elif command == "delete":
        delete()
    elif command == "list":
        pets_list()
    elif command == "stop":
        print("Выход из программы.")
        break
    else:
        print("Неизвестная команда.")
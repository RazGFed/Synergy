x = float(input('Введите минимальную сумму инвестиций: '))
a = float(input('Введите сколько долларов у Майкла: '))
b = float(input('Введите сколько долларов у Ивана: '))

if a >= x and b < x:
    print('Mike')
elif a < x and b >= x: 
    print('Ivan')
elif a < x and b < x and(a+b) >= x:
    print(1)
elif a >= x and b >= x:
    print(2)
else:
    print(0)